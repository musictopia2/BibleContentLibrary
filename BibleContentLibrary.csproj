<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>9.0.1</Version>
    <FeedType>Public</FeedType>
    <RunPostBuildAppCondition Condition="'$(Configuration)' == 'Release'">true</RunPostBuildAppCondition>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Resources\TranslationList.json" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Resources\TranslationList.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Musictopia2.BibleDatabaseLibrary" Version="10.0.1" />
    <PackageReference Include="Musictopia2.BibleICBTranslationLibrary" Version="10.0.1" />
    <PackageReference Include="Musictopia2.BibleKJVTranslationLibrary" Version="10.0.1" />
    <PackageReference Include="Musictopia2.BibleNIVTranslationLibrary" Version="10.0.1" />
    <PackageReference Include="Musictopia2.BibleNKJVTranslationLibrary" Version="10.0.1" />
    <PackageReference Include="Musictopia2.BibleNLTTranslationLibrary" Version="10.0.1" />
    <PackageReference Include="Musictopia2.BibleTranslationsGenerator" Version="1.0.1" PrivateAssets="all" />
    <PackageReference Include="Musictopia2.JsonDeserializeResourceSourceGenerator" Version="1.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="C:\VS\Apps\CommandLines\PostBuildPackageHandler\bin\Release\net10.0\PostBuildPackageHandler.exe $(ProjectName) $(ProjectDir) $(ProjectFileName) $(TargetDir)" Condition="'$(Configuration)' == 'Release' and '$(RunPostBuildAppCondition)' == 'true'" />
  </Target>
</Project>